# ENVIRONMENT VARIABLES FOR DOCMAN BACKEND
# -------------------------------------------------------------
# This file is used to configure the environment for the DocMan backend application.
# This is a default configuration that will be used in the event that a development or production environment is not specified.
# You will need to create a development and production environment file in the same directory as this file, named `.env.dev` and `.env.prod`, respectively.
# These files should contain the same variables as this file, but with the actual values for your environment.
# This serves as a template; replace the placeholders with your actual configuration values.
ACTIVE_ENV=0
ENV=Sample

# MongoDB Configuration
MONGO_URI=<MONGO_URI> # Optional full MongoDB connection string. Recommended for Render/Atlas, e.g. mongodb+srv://...
MONGODB_URI=<MONGODB_URI> # Optional alias for hosts that provide MONGODB_URI instead of MONGO_URI
MONGO_USER=<USERNAME> # Replace with your MongoDB username
MONGO_PASSWORD=<PASSWORD> # Replace with your MongoDB password
MONGO_HOST=<HOST_OR_IP> # MongoDB host (could be an IP address or hostname, such as 'localhost')
MONGO_PORT=<MONGO_PORT> # MongoDB port (default is 27017)
MONGO_DB=<DATABASE> # Database name
MONGO_AUTH_SOURCE=<AUTH_SOURCE> # Authentication source, usually 'admin' for MongoDB
MONGO_ATLAS_USER=<ATLAS_USER> # Username for MongoDB Atlas
MONGO_ATLAS_PASSWORD=<ATLAS_PASSWORD> # Password for MongoDB Atlas
MONGO_ATLAS_HOST=<ATLAS_HOST> # Hostname for MongoDB Atlas
MONGO_ATLAS_DB=<ATLAS_DB> # Database name for MongoDB Atlas
MONGO_ATLAS_APP=<ATLAS_APP> # Application name for MongoDB Atlas

# Node.js Server Configuration
NODE_ENV=<NODE_ENV> # Environment for Node.js (development, production, etc.)
NODE_PORT=<NODE_PORT> # Port for the Node.js server (the standard practice is to use 3000 for development)
DOCMAN_UI=vue # UI to build/serve in production: vue or react
SEED_ON_DEPLOY=false # Set true to run safe idempotent seeding during deployment
DOCMAN_DEFAULT_EMAIL=admin@example.com # Default account created by safe seed when users are empty
DOCMAN_DEFAULT_USERNAME=admin # Default account username
DOCMAN_DEFAULT_PASSWORD=DocMan123! # Change before production use

# Redis Configuration
UPSTASH_REDIS_REST_URL=<UPSTASH_REDIS_REST_URL> # URL for Upstash Redis REST API
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REDIS_REST_TOKEN> # Token for Upstash Redis REST API authentication

# Frontend Authentik Build Configuration
# These VITE_* values are copied into frontend-vue/.env.production by the deploy/update scripts
# when a real frontend-vue/.env.production file is not already present in the prepared source checkout.
VITE_AUTHENTIK_ENABLED=false
VITE_AUTHENTIK_CLIENT_ID=<AUTHENTIK_CLIENT_ID>
VITE_AUTHENTIK_AUTHORIZATION_URL=https://accounts.resonancedesigns.dev/application/o/authorize/
VITE_AUTHENTIK_REGISTRATION_URL=<AUTHENTIK_REGISTRATION_URL> # Example: https://accounts.resonancedesigns.dev/if/flow/<your-enrollment-flow>/
VITE_AUTHENTIK_TOKEN_URL=https://accounts.resonancedesigns.dev/application/o/token/
VITE_AUTHENTIK_REDIRECT_URI=https://docman.resonancedesigns.dev/auth/callback
VITE_AUTHENTIK_SCOPE=openid profile email

# Authentication Configuration
JWT_SECRET=<AUTH_TOKEN> # Preferred JWT secret for production. Use a long secure random value.
TOKEN_KEY=<AUTH_TOKEN> # Secret key for JWT or other authentication mechanisms. Can be any secure random string.
LOCAL_SELF_REGISTRATION_ENABLED=true # Set false in production when Authentik is the canonical suite registration authority
AUTHENTIK_ISSUER=<AUTHENTIK_ISSUER> # Example: https://accounts.resonancedesigns.dev/application/o/rdocman-web/
AUTHENTIK_AUDIENCE=<AUTHENTIK_AUDIENCE> # Usually the Authentik client ID / audience expected by DocMan
AUTHENTIK_CLIENT_ID=<AUTHENTIK_CLIENT_ID> # Optional alias to keep client naming explicit
AUTHENTIK_BASE_URL=<AUTHENTIK_BASE_URL> # Optional alias for issuer base if you standardize config this way
AUTHENTIK_JWKS_URL=<AUTHENTIK_JWKS_URL> # Preferred JWKS endpoint for verifying Authentik RS256 access tokens, e.g. https://accounts.resonancedesigns.dev/application/o/rdocman-web/jwks/
AUTHENTIK_JWT_PUBLIC_KEY=<AUTHENTIK_JWT_PUBLIC_KEY> # PEM-encoded public key for verifying Authentik RS256 access tokens; escape newlines as \\n in env files if needed

# AWS SES Configuration for Email Notifications
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID> # Your AWS access key ID for SES
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY> # Your AWS secret access key for SES
AWS_SES_REGION=<AWS_SES_REGION> # AWS region for SES (e.g., us-east-1)
AWS_SES_SENDER_EMAIL=<AWS_SES_SENDER_EMAIL> # Sender email address for SES (e.g., noreply@resonancedesigns.dev)
